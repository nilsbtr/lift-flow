<?xml version="1.0" encoding="utf-8"?>
<!-- Two rows: the week above the button. The days are added in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/LiftWidgetRoot"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/widget_button"
        style="@style/LiftWidgetButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_play" />

        <TextView
            android:id="@+id/widget_label"
            style="@style/LiftWidgetLabel"
            android:text="@string/widget_start" />
    </LinearLayout>
</LinearLayout>
