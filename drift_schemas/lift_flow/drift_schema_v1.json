          "sql": "CREATE TABLE IF NOT EXISTS \"rest_state\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"ends_at\" INTEGER NOT NULL, \"total_seconds\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
