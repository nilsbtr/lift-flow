  "fixed_sql": [
    {
      "name": "exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"muscle_group\" TEXT NOT NULL, \"tracking_type\" TEXT NOT NULL, \"load_mode\" TEXT NOT NULL DEFAULT 'none', \"notes\" TEXT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "workout_templates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workout_templates\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"position\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "template_exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"template_exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"template_id\" INTEGER NOT NULL REFERENCES workout_templates (id) ON DELETE CASCADE, \"exercise_id\" INTEGER NOT NULL REFERENCES exercises (id) ON DELETE RESTRICT, \"position\" INTEGER NOT NULL, \"target_sets\" INTEGER NOT NULL DEFAULT 3, \"reps_min\" INTEGER NULL, \"reps_max\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "workouts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workouts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"template_id\" INTEGER NULL REFERENCES workout_templates (id) ON DELETE SET NULL, \"name\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NULL, \"bodyweight_kg\" REAL NULL, \"total_sets\" INTEGER NOT NULL DEFAULT 0, \"total_volume_kg\" REAL NOT NULL DEFAULT 0.0, \"exercise_count\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "workout_exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workout_exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"workout_id\" INTEGER NOT NULL REFERENCES workouts (id) ON DELETE CASCADE, \"exercise_id\" INTEGER NOT NULL REFERENCES exercises (id) ON DELETE RESTRICT, \"position\" INTEGER NOT NULL, \"target_reps_min\" INTEGER NULL, \"target_reps_max\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "workout_sets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workout_sets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"workout_exercise_id\" INTEGER NOT NULL REFERENCES workout_exercises (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"load_kg\" REAL NULL, \"reps\" INTEGER NULL, \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), \"completed_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"weight_unit\" TEXT NOT NULL DEFAULT 'kg', \"theme_mode\" TEXT NOT NULL DEFAULT 'system', \"pure_black\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pure_black\" IN (0, 1)), \"bodyweight_kg\" REAL NULL, \"default_rest_seconds\" INTEGER NOT NULL DEFAULT 90, \"auto_start_rest\" INTEGER NOT NULL DEFAULT 1 CHECK (\"auto_start_rest\" IN (0, 1)), \"rest_alerts\" INTEGER NOT NULL DEFAULT 1 CHECK (\"rest_alerts\" IN (0, 1)), \"keep_screen_on\" INTEGER NOT NULL DEFAULT 0 CHECK (\"keep_screen_on\" IN (0, 1)), \"permissions_prompted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"permissions_prompted\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
